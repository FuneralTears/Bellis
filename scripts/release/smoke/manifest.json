{
  "version": 1,
  "about": "Every SQL smoke of supabase/tests. Read by scripts/release/smoke/manifest.mjs; a smoke file that is not listed here is an error.",
  "contract": {
    "name": "bellis_smoke_v1",
    "pass": "PASS",
    "row": ["contract", "smoke", "result", "nonce", "txid"],
    "about": "The runner adds the result row as the last statement of each smoke's transaction, with the smoke's id and a value made up for the run. A smoke passes when the CLI exits 0 with no SQL error, that row is the answer, it says PASS, and PostgreSQL reports the transaction as aborted afterwards."
  },
  "defaults": {
    "timeoutSeconds": 120
  },
  "groups": {
    "core": "Booking, availability, questionnaires, payments, Mercado Pago, onboarding and roles.",
    "crm": "Patients, notes, follow-ups, automations and internal notifications.",
    "plans": "Free, Pro and the trial: what each plan allows and how a plan changes.",
    "admin": "The internal backoffice: who can read, who can act, and what is recorded.",
    "release": "The gate of a release: everything that has to pass before production. Today, every smoke."
  },
  "smokes": [
    {
      "id": "admin_activate_pro",
      "file": "supabase/tests/admin_activate_pro_smoke.sql",
      "groups": ["admin", "plans", "release"],
      "expect": {
        "result": "PASS"
      },
      "requires": ["the vault extension (a throwaway secret is created and rolled back)"]
    },
