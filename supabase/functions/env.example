# Edge Function secrets. Names only: set the values in Supabase Dashboard → Edge Functions → Secrets,
# or in supabase/functions/.env for local development (ignored by Git). Never use NEXT_PUBLIC_ for these.

# Each Supabase project (staging, production) has its own values. Never copy a secret from one to the other.
# Full table and deploy order: supabase/MERCADO_PAGO.md

# Site. Required, with no default: the exact origin of this environment's site, no path and no trailing slash.
BELLIS_SITE_ORIGIN=
# Optional. Comma-separated exact HTTPS origins outside the Bellis Vercel project. Bellis project previews under the
# bellis1 team are recognized by the restricted origin policy. Empty in production.
BELLIS_ADDITIONAL_ORIGINS=

# Mercado Pago application (OAuth). The three functions need them: any of them may have to renew a token.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
# Optional. Defaults to <BELLIS_SITE_ORIGIN>/mercado-pago/callback
MERCADO_PAGO_REDIRECT_URI=
# Optional. "true" asks Mercado Pago for test credentials when exchanging the code.
# Staging only. It must not exist in production.
MERCADO_PAGO_OAUTH_TEST_TOKEN=

# Mercado Pago webhooks. The signing secret of this environment's application. Without it the checkout is not offered.
MERCADO_PAGO_WEBHOOK_SECRET=

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase.

# Google Calendar (bellis-google-oauth). Without the three, connecting answers "todavía no está disponible";
# disconnecting still works. Full setup: docs/google-calendar.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact address registered in the OAuth client. Defaults to <BELLIS_SITE_ORIGIN>/google-calendar/callback.
# Development: http://localhost:5173/google-calendar/callback. Never a Vercel preview address.
GOOGLE_REDIRECT_URI=
